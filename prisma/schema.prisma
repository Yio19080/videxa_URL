datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum VideoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  SUBSCRIPTION
  AD_TOPUP
}

enum PaymentMethod {
  BINANCE_PAY
  BANKAK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AdType {
  DISCOVER_FEED
  STORE_BANNER
  EDITOR
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  role       Role      @default(USER)
  plan       Plan      @default(FREE)
  planExpiry DateTime?
  adBalance  Float     @default(0.0)
  createdAt  DateTime  @default(now())

  videos   Video[]
  payments Payment[]
  ads      Ad[]
}

model Template {
  id         String   @id @default(uuid())
  title      String
  category   String
  previewUrl String
  videoUrl   String
  duration   Int
  is4K       Boolean  @default(false)
  language   String   @default("ar")
  createdAt  DateTime @default(now())

  videos Video[]
}

model Video {
  id         String      @id @default(uuid())
  userId     String
  templateId String
  videoUrl   String
  status     VideoStatus @default(PENDING)
  views      Int         @default(0)
  likes      Int         @default(0)
  createdAt  DateTime    @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  amount          Float
  currency        String        @default("USDT")
  orderId         String        @unique
  type            PaymentType
  method          PaymentMethod @default(BINANCE_PAY)
  receiptImg      String?
  transactionRef  String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ad {
  id          String   @id @default(uuid())
  userId      String
  title       String
  videoUrl    String?
  imageUrl    String?
  type        AdType
  bidAmount   Float    @default(20.0)
  dailyBudget Float
  spent       Float    @default(0.0)
  status      String   @default("ACTIVE")
  clicks      Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
